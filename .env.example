# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=wikirag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wikirag
POSTGRES_PORT=5432

# Async URL used by the backend (SQLAlchemy + asyncpg)
DATABASE_URL=postgresql+asyncpg://wikirag:change-me@localhost:5432/wikirag

# --- Google Cloud / Vertex AI ---
# Local auth: gcloud auth application-default login (no API key needed)
GCP_PROJECT=your-gcp-project-id
GCP_LOCATION=global

# --- Embeddings ---
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768

# --- LLM ---
LLM_PROVIDER=google
LLM_MODEL=gemini-3.8-flash
# Optional: faster model for understand, research, finalize and /ask (grounding keeps LLM_MODEL)
LLM_FAST_MODEL=gemini-3.5-flash-lite

# --- API access ---
# Clients send this as the X-API-Key header on /ask, /agent/ask and /conversations.
# Empty = no auth (local development only). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
API_KEY=

# --- Frontend (Streamlit) ---
API_BASE_URL=http://localhost:8000

# --- Docker (backend service) ---
# Path to your gcloud application-default credentials (gcloud auth application-default login),
# mounted into the container. Windows: C:/Users/<you>/AppData/Roaming/gcloud/application_default_credentials.json
# macOS/Linux: /home/<you>/.config/gcloud/application_default_credentials.json
GCP_ADC_FILE=/path/to/application_default_credentials.json
# Host port for the API (the container listens on 8080)
BACKEND_PORT=8000
