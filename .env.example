# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=wikirag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wikirag
POSTGRES_PORT=5432

# Async URL used by the backend (SQLAlchemy + asyncpg)
DATABASE_URL=postgresql+asyncpg://wikirag:change-me@localhost:5432/wikirag

# --- Google Cloud / Vertex AI ---
# Local auth: gcloud auth application-default login (no API key needed)
GCP_PROJECT=your-gcp-project-id
GCP_LOCATION=asia-southeast1

# --- Embeddings ---
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768

# --- LLM ---
LLM_PROVIDER=google
LLM_MODEL=gemini-3.8-flash

# --- Frontend (Streamlit) ---
API_BASE_URL=http://localhost:8000
